{
  "name": "maplora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/client",
    "src/server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "build": "tsc -p tsconfig.client.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:compose": "node scripts/verify-compose.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@xyflow/react": "^12.8.0",
    "d3-flextree": "^2.1.2",
    "hono": "^4.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-flextree": "^2.1.4",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.0",
    "fast-check": "^4.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  }
}
